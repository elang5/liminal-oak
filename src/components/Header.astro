---
import { siteConfig } from '../config/site';
const navLinks = [{href: '/#approach', label: 'Approach'}, {href: '/#about', label: 'About'}, {href: '/#services', label: 'Details'}, {href: '/#contact', label: 'Contact'}];
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/#home">Liminal Oak<span>Therapy</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">{navLinks.map(link => <a href={link.href}>{link.label}</a>)}<a class="nav-cta" href={siteConfig.contactUrl}>Let&rsquo;s connect <span aria-hidden="true">↗</span></a></nav>
    <details class="mobile-nav">
      <summary aria-label="Navigation menu"><span class="menu-lines" aria-hidden="true"></span><span>Menu</span></summary>
      <nav aria-label="Mobile navigation">{navLinks.map(link => <a href={link.href}>{link.label}</a>)}<a href={siteConfig.contactUrl}>Request a consultation ↗</a></nav>
    </details>
  </div>
</header>
