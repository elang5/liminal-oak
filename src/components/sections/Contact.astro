---
import { siteConfig } from '../../config/site';
import OakRings from '../OakRings.astro';
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <OakRings />
  <div class="container contact-content">
    <p class="eyebrow">Get in touch</p>
    <h2 id="contact-title">Let&rsquo;s see how<br /><em>we connect.</em></h2>
    <p>You don&rsquo;t have to know exactly what you need yet. Tell me a little about what brings you here, and we can start with a conversation.</p>
    <a class="button button-light" href={siteConfig.contactUrl}>Request a free consultation <span aria-hidden="true">↗</span></a>
    <p class="contact-note">Contact me through SimplePractice.<br />I typically respond within 1–2 business days.</p>
    <p class="contact-email">Have a question first? You&rsquo;re welcome to email me at <a href={`mailto:${siteConfig.author.email}`}>{siteConfig.author.email}</a>.</p>
    <div class="contact-details"><span>15 minutes · Phone or video</span><span>Telehealth for Washington residents</span></div>
  </div>
</section>
