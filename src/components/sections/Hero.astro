---
import { siteConfig } from '../../config/site';
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-image" aria-hidden="true"></div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content container">
    <p class="eyebrow">Telehealth therapy · Washington</p>
    <h1 id="hero-title">A place for what<br />you&rsquo;re <em>carrying.</em></h1>
    <p class="hero-description">Telehealth therapy for adults in Washington navigating complex trauma, addiction, and psychedelic experiences.</p>
    <a class="button button-light" href={siteConfig.contactUrl}>Request a free consultation <span aria-hidden="true">↗</span></a>
    <p class="hero-note">Elan Green, MSW, LSWAIC · Accepting new clients</p>
  </div>
  <a class="hero-scroll" href="#approach">A little about the work <span aria-hidden="true">↓</span></a>
</section>
