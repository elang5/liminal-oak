---
import { siteConfig } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner"><p>&copy; {year} Elan Green PLLC</p><p>{siteConfig.author.name}, {siteConfig.author.credentials}</p><a href={`mailto:${siteConfig.author.email}`}>{siteConfig.author.email}</a></div>
  <details class="little-oak">
    <summary aria-label="Plant an oak" title="Plant an oak">
      <svg width="24" height="28" viewBox="0 0 32 36" fill="none" aria-hidden="true">
        <path d="M16 8c0-4 2-5 4-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M8 17c0 9 4 14 8 17 4-3 8-8 8-17" fill="currentColor" fill-opacity=".18" stroke="currentColor" stroke-width="1.5" />
        <path d="M5 17c0-6 5-10 11-10s11 4 11 10H5Z" fill="currentColor" fill-opacity=".35" stroke="currentColor" stroke-width="1.5" />
        <path d="m10 10 4 7m3-9 5 9m-1-7-5 7m-2-8-5 8" stroke="currentColor" stroke-opacity=".5" />
      </svg>
    </summary>
    <div class="little-oak-reveal">
      <svg class="oak-tree" width="240" height="220" viewBox="0 0 240 220" fill="none" role="img" aria-label="An acorn growing into an oak tree">
        <path d="M58 207q62-8 124 0" stroke="currentColor" stroke-opacity=".25" stroke-linecap="round" />
        <g class="oak-branches" stroke="#b8b69a" stroke-linecap="round" stroke-linejoin="round">
          <path class="oak-trunk" pathLength="1" d="M120 204c-2-27 4-49 1-72s-6-48 1-76" stroke-width="5" />
          <path class="oak-branch" pathLength="1" d="M121 156 95 130 77 96m20 36L59 119m62 18 29-28 18-31m-19 33 36-8M119 107 99 84 95 59m24 37 21-22 7-30" stroke-width="2.5" />
          <path class="oak-roots" pathLength="1" d="m120 199-12 7m12-7 13 8" stroke-width="2" />
        </g>
        <g class="oak-canopy" fill="#8dAA76">
          <path style="--leaf-delay:.9s;--leaf-x:68px;--leaf-y:116px" d="M73 130c-16 8-41-1-41-17-13-6-8-23 5-25-3-15 16-24 27-15 12-12 30-1 27 13 17 2 17 20 5 27 1 11-12 20-23 17Z" />
          <path style="--leaf-delay:1.15s;--leaf-x:169px;--leaf-y:106px" d="M166 124c-20 4-34-9-29-24-12-10-5-26 9-26 2-17 22-21 31-9 15-7 29 4 25 18 19 8 12 29-3 30-6 16-22 19-33 11Z" />
          <path style="--leaf-delay:1.4s;--leaf-x:102px;--leaf-y:76px" d="M99 96C79 99 64 87 69 72 54 62 61 43 77 43 73 26 95 18 106 29c13-13 33-2 31 12 17 4 19 23 5 32-1 18-25 27-43 23Z" />
          <path style="--leaf-delay:1.65s;--leaf-x:148px;--leaf-y:60px" d="M145 81c-17 1-29-13-24-26-12-11-2-25 10-25 2-15 21-19 29-6 17-6 30 9 23 22 13 11 4 27-10 27-5 10-18 14-28 8Z" />
          <path style="--leaf-delay:1.9s;--leaf-x:119px;--leaf-y:109px" d="M118 128c-18 6-37-6-33-20-13-9-7-26 7-27 5-15 23-17 32-5 17-5 31 9 24 22 12 14-5 33-30 30Z" />
        </g>
      </svg>
    </div>
  </details>
</footer>
