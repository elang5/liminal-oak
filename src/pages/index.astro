---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Approach from '../components/sections/Approach.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import Psychedelic from '../components/sections/Psychedelic.astro';
import Contact from '../components/sections/Contact.astro';
---
<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <Approach />
    <About />
    <Psychedelic />
    <Services />
  </main>
  <div class="grove">
    <canvas class="etch-trail" data-src="/images/woodland-reflection.jpg" data-flip data-surface=".contact" data-shield=".contact-content" data-dim-bottom="0.7" aria-hidden="true"></canvas>
    <Contact />
    <Footer />
  </div>
</BaseLayout>
<script src="../scripts/etch-trail.js"></script>
